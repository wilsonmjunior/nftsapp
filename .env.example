VITE_API_URL=https://api.mktnft.mock
VITE_SOCKET_URL=https://realtime.mktnft.mock
VITE_ENABLE_MOCKS=true
# Cenário inicial dos mocks (default, fast, slow, jitter, out-of-order, offline, server-error, flaky,
# empty, session-expired, price-change, sold-out, order-timeout, payment-declined). Também aceita ?scenario= na URL.
VITE_MOCK_SCENARIO=
# Mostra o painel flutuante para trocar cenário, expirar sessões e restaurar a seed.
VITE_MOCK_PANEL=true
